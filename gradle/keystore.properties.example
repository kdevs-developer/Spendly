# Copy to keystore.properties (git-ignored) and fill in. Never commit the real file.
# Keeps your debug SHA-1 the same, so Google sign-in keeps working.
storeFile=debug.keystore
storePassword=CHANGE_ME
keyAlias=androiddebugkey
keyPassword=CHANGE_ME

# Optional: signs the release build
# releaseStoreFile=release.keystore
# releaseStorePassword=CHANGE_ME
# releaseKeyAlias=spendly
# releaseKeyPassword=CHANGE_ME
