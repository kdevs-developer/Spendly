rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(chat) { return signedIn() && request.auth.uid in chat.members; }

    // Everything under users/{uid}: accounts, categories, transactions, budgets,
    // goals, templates, recurring, friends, blocked. Owner only.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Friend code lookup: code -> uid + display name.
    match /userCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friend requests live in the receiver's inbox; the sender may create one.
    match /requests/{reqId} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read, update, delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // Members may rename, add members, or leave (remove themselves).
      allow update: if isMember(resource.data);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;
        // Members may add reactions and read receipts. The sender may delete
        // for everyone within 5 minutes of sending.
        allow update: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy'])
            || (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'imageUrl'])
              && request.time < resource.data.createdAt + duration.value(5, 'm')
            )
          );
        allow delete: if false;
      }

      match /splits/{splitId} {
        allow read, create, update: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow delete: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && resource.data.createdBy == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
